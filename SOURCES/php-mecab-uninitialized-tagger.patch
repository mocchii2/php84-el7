--- /dev/null
+++ b/mecab/tests/tagger_uninitialized.phpt
@@ -0,0 +1,34 @@
+--TEST--
+Uninitialized MeCab tagger rejects native method calls
+--EXTENSIONS--
+mecab
+--FILE--
+<?php
+$valid = new MeCab\Tagger();
+$node = $valid->parseToNode('test');
+$tagger = new MeCab\Tagger(['-r' => __DIR__ . '/missing-mecabrc-for-test']);
+foreach ([
+    ['parse', ['test']],
+    ['parseToNode', ['test']],
+    ['getPartial', []],
+    ['setPartial', [true]],
+    ['dictionaryInfo', []],
+    ['formatNode', [$node]],
+] as [$method, $arguments]) {
+    try {
+        $tagger->$method(...$arguments);
+        throw new RuntimeException("$method accepted an uninitialized tagger");
+    } catch (BadMethodCallException $exception) {
+        echo $method, ': ', $exception->getMessage(), "\n";
+    }
+}
+?>
+--EXPECTF--
+
+Warning: MeCab\Tagger::__construct(): '%s/missing-mecabrc-for-test' does not exist or is not readable in %s on line %d
+parse: MeCab is not initialized
+parseToNode: MeCab is not initialized
+getPartial: MeCab is not initialized
+setPartial: MeCab is not initialized
+dictionaryInfo: MeCab is not initialized
+formatNode: MeCab is not initialized
